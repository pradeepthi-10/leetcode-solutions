class Solution {
    public long[] sumOfThree(long num) {
         if((num-3)%3!=0){
        return new long[]{};
        }
        
        long x = (num-3)/3;
        long arr[]=new long[3];
        arr[0]=x;
        arr[1]=x+1;
        arr[2]=x+2;
        
        return arr;
        
    }
}
// its just a math probl without any loops or recursion. we can find the first number by subtracting 3 from the given number and dividing it by 3. then we can find the next two numbers by adding 1 and 2 to the first number. if the given number is not divisible by 3, then we return an empty array.
// Time complexity: O(1)