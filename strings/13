class Solution {
    public int romanToInt(String s) {
        int sum =0;
      for(int i=0;i<s.length()-1;i++){
        char ch = s.charAt(i);
        int value = 0;
      int cv = value(s.charAt(i));
       int nv = value(s.charAt(i+1));
       
        if(cv<nv){
            sum = sum-cv;
        }
        else
        sum = sum+cv;

      }
       sum = sum + value(s.charAt(s.length() - 1));
      return sum;

    }
    public int value(char ch) {
        if (ch == 'I')
            return 1;
        else if (ch == 'V')
            return 5;
        else if (ch == 'X')
            return 10;
        else if (ch == 'L')
            return 50;
        else if (ch == 'C')
            return 100;
        else if (ch == 'D')
            return 500;
        else
            return 1000;
}
}