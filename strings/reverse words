class Solution {
    public String reverseWords(String s) {
        String[] words =s.split(" ");
        String ans ="";
        for(int i=0;i<words.length;i++){
            for(int j=words[i].length()-1;j>=0;j--){
               ans = ans+words[i].charAt(j);
            }
             ans = ans+" ";
        } 
        return ans.trim();
    }
}
// trim removes extra sdpaces at the end of the string.
// in this code, we first split the input string into words using the split method. Then, we iterate through each word and reverse it by iterating through its characters in reverse order. We concatenate the reversed words to the ans string, adding a space after each word. Finally, we return the ans string after trimming any extra spaces at the end.