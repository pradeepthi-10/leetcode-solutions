class Solution {
    public boolean isMonotonic(int[] nums) {
       
       boolean a = nums[0] <= nums[nums.length - 1];
        for(int i=0;i<nums.length-1;i++){
        if(a && nums[i]>nums[i+1]){
           return false;
        }
        if(!a && nums[i]<nums[i+1]){
        return false;
        }
    }
    return true;
}
}