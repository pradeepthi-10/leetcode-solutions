class Solution {
    public int dominantIndex(int[] nums) {
        int max = nums[0];
        int sec=max;
        int index = 0;
        for(int i=0;i<nums.length;i++){
            if(nums[i]>max){
                 sec = max;
                max=nums[i];
                index = i;
            }
            else if(nums[i]>sec && nums[i]<max){
                sec = nums[i];
            }
        }
        if(max>=2*sec)
        return index;
        else return -1;
    }
}
