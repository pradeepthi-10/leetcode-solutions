class Solution {
    public int sumOfUnique(int[] nums) {
        int n = nums.length;
       HashMap<Integer,Integer> map = new HashMap<>();
       int sum=0;
        for(int i=0;i<n;i++){
            int num =nums[i];
        if(map.containsKey(num)){
             map.put(num,map.get(num)+1);
        }
        else
        map.put(num,1);
        }
        for(int i=0;i<n;i++){
        if(map.get(nums[i])==1)
        sum+=nums[i];
        }
        return sum;
    }
}
