class Solution {
    public List<Integer> findDisappearedNumbers(int[] nums) {
        List<Integer> List = new ArrayList<>();
        HashSet<Integer> set = new HashSet<>();
        for(int i=0;i<nums.length;i++){
            set.add(nums[i]);
        }
        for(int i=1;i<=nums.length;i++){
            if(!set.contains(i)){
                List.add(i);
            }
        }
        return List;
    }
}
// we found the disappeared elements in the array by using a hashset. We first add all the elements of the array to the hashset. Then we iterate through the numbers from 1 to n (where n is the length of the array) and check if each number is present in the hashset. If a number is not present, we add it to the result list. Finally, we return the list of disappeared numbers. This approach has a time complexity of O(n) and a space complexity of O(n).
