class Solution {
    public int findLengthOfLCIS(int[] nums) {
          int maxcount=1;
            int count=1;
        for(int i=0;i<nums.length-1;i++){
            if(nums[i]<nums[i+1]){
                count++;
            }
            else {
            count=1;
            }
             maxcount=Math.max(count,maxcount);
        }
        return maxcount;
    }
}
