class Solution {
    public int[][] flipAndInvertImage(int[][] image) {
        //int r = image.length;
        //int c = mat[0].length;
        for(int i=0;i<image.length;i++){
        int left =0;
        int right = image.length-1;
        while(left<=right){
                int temp = 1- image[i][left];
               image[i][left]=1-image[i][right];
                image[i][right]=temp;
                left++;
                right--;
        }
        }
        return image;
  
    }
}
// in this solution we just use temp variable and swap the letters and we want to invert from 0 to 1 and reverse
