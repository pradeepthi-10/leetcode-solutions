class Solution {
    public int diagonalSum(int[][] mat) {
        int n = mat.length;
        int sum =0;
        int add =0;
       // int c = mat[0].length;
        for(int i=0;i<n;i++){
            sum+=mat[i][i];
            if(i==n-i-1){
                continue;
            }
            else{
            add+=mat[i][n-i-1];
            }
        }
        return sum+add;
    }
}